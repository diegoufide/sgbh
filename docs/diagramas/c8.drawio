ry"/></mxCell><mxCell id="c35" value="&lt;div style=&quot;line-height:18px;&quot;&gt;ACEPTADA&lt;br&gt;EDITADA&lt;br&gt;DESCARTADA&lt;/div&gt;" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;spacing=0;spacingLeft=9;spacingRight=4;spacingTop=-0.5;overflow=hidden;rotatable=0;points=[[0,0.5],[1,0.5]];portConstraint=eastwest;whiteSpace=nowrap;fontFamily=Arial;fontSize=13;fontColor=#111827;" vertex="1" connectable="0" parent="c34"><mxGeometry x="0" y="42" width="143" height="62" as="geometry"/></mxCell><mxCell id="c36" value="&lt;span style=&quot;font-size:12px;font-weight:normal;font-style:italic&quot;&gt;«enumeration»&lt;/span&gt;&lt;br&gt;Frecuencia" style="swimlane;html=1;whiteSpace=wrap;fontFamily=Arial;fontSize=14;fontStyle=1;fontColor=#FFFFFF;fillColor=#4B53A8;swimlaneFillColor=#FFFFFF;strokeColor=#2B338C;strokeWidth=1.4;startSize=42;align=center;verticalAlign=middle;childLayout=stackLayout;horizontal=1;horizontalStack=0;resizeParent=1;resizeParentMax=0;resizeLast=0;collapsible=0;marginBottom=0;swimlaneLine=1;" vertex="1" parent="1"><mxGeometry x="723" y="780" width="120" height="86" as="geometry"/></mxCell><mxCell id="c37" value="&lt;div style=&quot;line-height:18px;&quot;&gt;MENSUAL&lt;br&gt;TRIMESTRAL&lt;/div&gt;" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;spacing=0;spacingLeft=9;spacingRight=4;spacingTop=-0.5;overflow=hidden;rotatable=0;points=[[0,0.5],[1,0.5]];portConstraint=eastwest;whiteSpace=nowrap;fontFamily=Arial;fontSize=13;fontColor=#111827;" vertex="1" connectable="0" parent="c36"><mxGeometry x="0" y="42" width="120" height="44" as="geometry"/></mxCell><mxCell id="c38" value="&lt;div style=&quot;line-height:16px;&quot;&gt;Solo un ModeloIA por tipo puede estar ACTIVO. Si las métricas no alcanzan el mínimo (F1 ≥ 0,70 y MAE ≤ 3 días; top-5 ≥ 0,60 y&lt;br&gt;MAPE ≤ 25 %; exactitud ≥ 0,80) el modelo queda RECHAZADO y sigue el anterior (IA-006). Riesgo: ALTO ≥ 70 %, MEDIO 40-69 %, BAJO &amp;lt; 40 %.&lt;br&gt;Cada predicción o sugerencia guarda la versión del modelo que la generó (IA-015). Los modelos corren en el servicio Python (sgbh-ia).&lt;/div&gt;" style="shape=note;size=12;html=1;whiteSpace=nowrap;fillColor=#FFFBEB;strokeColor=#B45309;strokeWidth=1.2;align=left;verticalAlign=top;spacing=0;spacingLeft=8;spacingTop=1.84;fontFamily=Arial;fontSize=12;fontColor=#78350F;" vertex="1" parent="1"><mxGeometry x="20" y="950" width="960" height="64" as="geometry"/></mxCell><mxCell id="c39" value="" style="edgeStyle=orthogonalEdgeStyle;html=1;rounded=0;strokeColor=#2B338C;strokeWidth=1.3;endArrow=open;endSize=11;startArrow=none;fontFamily=Arial;fontSize=12;fontColor=#111827;exitX=0;exitY=0.25;exitDx=0;exitDy=0;exitPerimeter=0;entryX=1;entryY=0.272059;entryDx=0;entryDy=0;entryPerimeter=0;" edge="1" parent="1" source="c6" target="c2"><mxGeometry relative="1" as="geometry"><mxPoint x="350" y="75.5" as="sourcePoint"/><mxPoint x="239" y="75.5" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c40" value="0..*" style="edgeLabel;html=1;resizable=0;align=center;verticalAlign=middle;labelBackgroundColor=#FFFFFF;fontFamily=Arial;fontSize=12;fontColor=#111827;fontStyle=0;" vertex="1" connectable="0" parent="c39"><mxGeometry x="-1" relative="1" as="geometry"><mxPoint x="-16" y="9.34" as="offset"/></mxGeometry></mxCell><mxCell id="c41" value="1" style="edgeLabel;html=1;resizable=0;align=center;verticalAlign=middle;labelBackgroundColor=#FFFFFF;fontFamily=Arial;fontSize=12;fontColor=#111827;fontStyle=0;" vertex="1" connectable="0" parent="c39"><mxGeometry x="1" relative="1" as="geometry"><mxPoint x="16" y="9.34" as="offset"/></mxGeometry></mxCell><mxCell id="c42" value="entrenado con" style="edgeLabel;html=1;resizable=0;align=center;verticalAlign=middle;labelBackgroundColor=#FFFFFF;fontFamily=Arial;fontSize=12;fontColor=#1F2937;fontStyle=2;" vertex="1" connectable="0" parent="c39"><mxGeometry x="0" relative="1" as="geometry"><mxPoint x="0" y="-12.66" as="offset"/></mxG