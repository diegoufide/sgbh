# Copiar como infra/.env y completar. Nunca subir el archivo .env al repositorio.
POSTGRES_DB=sgbh
POSTGRES_USER=sgbh_app
POSTGRES_PASSWORD=<clave-base-de-datos>

SGBH_DB_URL=jdbc:postgresql://sgbh-db:5432/sgbh
SGBH_DB_USUARIO=sgbh_app
SGBH_DB_CLAVE=<clave-base-de-datos>

SGBH_IA_URL=http://sgbh-ia:8000
SGBH_IA_TOKEN=<token-compartido-web-ia>
SGBH_CIFRADO_CLAVE=<clave-aes-256-en-base64>

SGBH_SMTP_HOST=<servidor-smtp>
SGBH_SMTP_PUERTO=587
SGBH_SMTP_USUARIO=<usuario-smtp>
SGBH_SMTP_CLAVE=<clave-smtp>

SGBH_RESPALDO_CLAVE=<clave-para-cifrar-respaldos>
